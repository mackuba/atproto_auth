module AuthProto
  module Storage
    class KeyBuilder
      NAMESPACE_SEPARATOR: String
      NAMESPACE_PREFIX: String
      def self.session_key: (String id) -> String
      def self.state_key: (String token) -> String
      def self.nonce_key: (String server_url) -> String
      def self.dpop_key: (String client_id) -> String
      def self.lock_key: (String namespace, String id) -> String

      private
      private def self.build_key: (*String parts) -> String
    end
  end
end
