module AuthProto
  module Identity
    class Resolver
      PLC_DIRECTORY_URL: String
      DID_PLC_PREFIX: String
      HANDLE_REGEX: Regexp

      def initialize: (?plc_directory: String?) -> void
      def resolve_handle: (String handle) -> resolution
      def get_did_info: (String did) -> resolution
      def verify_pds_binding: (String did, String pds_url) -> true
      def verify_issuer_binding: (String did, String issuer) -> true
      def verify_handle_binding: (String handle, String did) -> true

      private
      def validate_handle!: (String handle) -> void
      def normalize_handle: (String handle) -> String
      def resolve_handle_dns: (String handle) -> String?
      def extract_domain: (String handle) -> String
      def fetch_txt_records: (String domain) -> Array[String]
      def valid_did?: (String did) -> bool
      def resolve_handle_http: (String handle) -> resolution
      def fetch_did_document: (String did) -> json_object
      def fetch_plc_did_document: (String did) -> json_object
      def fetch_web_did_document: (String did) -> json_object
      def validate_pds_url!: (String url) -> void
      def normalize_url: (String url) -> String
      def logger: () -> Logger
    end
  end
end
