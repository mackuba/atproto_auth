module AuthProto
  module Serialization
    class DPoPKey < Base[DPoP::KeyManager]
      def self.serialize: (DPoP::KeyManager obj) -> String
      def self.deserialize: (String data) -> DPoP::KeyManager
      def type_identifier: () -> String

      private
      def validate_object!: (DPoP::KeyManager obj) -> void
      def serialize_data: (DPoP::KeyManager obj) -> json_object
      def deserialize_data: (json_object data) -> DPoP::KeyManager
    end
  end
end
