module AuthProto
  module State
    class Session
      include MonitorMixin

      attr_reader session_id: String
      attr_reader state_token: String
      attr_reader client_id: String
      attr_reader scope: String
      attr_reader pkce_verifier: String
      attr_reader pkce_challenge: String
      attr_reader auth_server: ServerMetadata::AuthorizationServer?
      attr_reader did: String?
      attr_reader tokens: TokenSet?

      def initialize: (client_id: String, scope: String, ?auth_server: ServerMetadata::AuthorizationServer?, ?did: String?) -> void
      def authorization_server=: (ServerMetadata::AuthorizationServer server) -> ServerMetadata::AuthorizationServer
      def did=: (String did) -> String
      def tokens=: (TokenSet tokens) -> String
      def authorized?: () -> bool
      def renewable?: () -> bool
      def validate_state: (String? state) -> bool

      private
      def secure_compare: (String str1, String str2) -> bool
    end
  end
end
