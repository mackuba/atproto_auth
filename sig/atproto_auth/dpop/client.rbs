module AuthProto
  module DPoP
    class Client
      class Error < AuthProto::Error
      end

      attr_reader key_manager: KeyManager
      attr_reader proof_generator: ProofGenerator
      attr_reader nonce_manager: NonceManager

      def initialize: (?key_manager: KeyManager?, ?nonce_ttl: Integer?) -> void
      def generate_proof: (http_method: String, http_uri: String, ?access_token: String?, ?nonce: String?) -> JOSE::SignedBinary
      def process_response: (Hash[String, String]? response_headers, String server_url) -> void
      def request_headers: (String proof) -> { "DPoP" => String }
      def public_key: () -> json_object
      def export_key: (?include_private: bool) -> JOSE::Map

      private
      def extract_nonce: (Hash[String | Symbol, String] headers) -> String?
      def origin_for_uri: (URI::HTTP uri) -> String
    end
  end
end
