module AuthProto
  module ServerMetadata
    class OriginURL
      @url: String
      @uri: URI::Generic

      attr_reader url: String
      attr_reader uri: URI::Generic

      def initialize: (String url) -> void

      def valid?: () -> bool

      private

      def https_scheme?: () -> bool
      def root_path?: () -> bool
      def explicit_port?: () -> bool
    end
  end
end
