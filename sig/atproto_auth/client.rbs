module AuthProto
  class Client
    class CallbackError < AuthProto::Error
    end
    class TokenError < AuthProto::Error
    end
    class SessionError < AuthProto::Error
      attr_reader session_id: String?
      def initialize: (String message, ?session_id: String?) -> void
    end

    attr_reader client_id: String
    attr_reader redirect_uri: String
    attr_reader client_metadata: ClientMetadata
    attr_reader session_manager: State::SessionManager
    attr_reader identity_resolver: Identity::Resolver
    attr_reader dpop_client: DPoP::Client

    def initialize: (client_id: String, redirect_uri: String, ?metadata: json_object?, ?dpop_key: (json_object | JOSE::Map)?) -> void
    def authorize: (?handle: String?, ?pds_url: String?, ?scope: String) -> authorization_result
    def handle_callback: (code: String, state: String, iss: String) -> callback_result
    def get_tokens: (String session_id) -> token_info?
    def refresh_token: (String session_id) -> refreshed_tokens
    def authorized?: (String session_id) -> bool
    def auth_headers: (session_id: String, method: String, url: String) -> Hash[String, String]
    def remove_session: (String session_id) -> void
    def cleanup_expired_sessions: () -> void

    private
    def load_client_metadata: (json_object? metadata) -> ClientMetadata
    def validate_redirect_uri!: () -> void
    def initialize_dpop: ((json_object | JOSE::Map)? key) -> DPoP::Client
    def validate_auth_params!: (String? handle, String? pds_url, String scope) -> void
    def resolve_from_handle: (String handle, State::Session session) -> { server: ServerMetadata::AuthorizationServer, pds: String }
    def resolve_from_pds: (String pds_url, State::Session session) -> { server: ServerMetadata::AuthorizationServer, pds: String }
    def resolve_auth_server: (String pds_url) -> ServerMetadata::AuthorizationServer
    def generate_authorization_url: (ServerMetadata::AuthorizationServer auth_server, State::Session session, ?login_hint: String?) -> String
    def exchange_code: (code: String, session: State::Session) -> json_object
    def make_token_request: (String code, State::Session session) -> http_response
    def requires_dpop_nonce?: (http_response response) -> bool
    def extract_dpop_nonce: (http_response response) -> String
    def validate_token_response!: (json_object response, State::Session session) -> void
  end
end
